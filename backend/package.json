{
  "name": "backend",
  "version": "0.0.1",
  "description": "backend for hungy app",
  "license": "MIT",
  "author": "Nea Kovalainen",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "node ./src/index.ts",
    "dev": "concurrently \"tsc --watch\" \"node --watch ./src/index.ts\"",
    "lint": "eslint .",
    "build:front": "rm -rf dist && cd ../frontend && npm run build && cp -r dist ../backend"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "2.6.5",
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "concurrently": "10.0.7",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "bcrypt": "6.0.0",
    "dotenv": "18.0.10",
    "eslint": "10.15.0",
    "express": "5.3.0",
    "jsonwebtoken": "9.0.3",
    "pg": "8.23.1",
    "sequelize": "6.37.8",
    "umzug": "3.8.3"
  }
}
